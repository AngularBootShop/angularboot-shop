# ==============================================================================
# Shop Microservices Environment Configuration Template (.env.example)
# Copy to .env and configure values for local or container deployment
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_CATALOG_DB=catalog_db
POSTGRES_CATALOG_USER=catalog_user
POSTGRES_CATALOG_PASSWORD=catalog_secret_pw
POSTGRES_CATALOG_PORT=5432

POSTGRES_ORDER_DB=order_db
POSTGRES_ORDER_USER=order_user
POSTGRES_ORDER_PASSWORD=order_secret_pw
POSTGRES_ORDER_PORT=5433

POSTGRES_KEYCLOAK_DB=keycloak_db
POSTGRES_KEYCLOAK_USER=keycloak_user
POSTGRES_KEYCLOAK_PASSWORD=keycloak_secret_pw
POSTGRES_KEYCLOAK_PORT=5434

# Keycloak IAM Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_master_secret
KEYCLOAK_PORT=8180
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/shop-realm
KEYCLOAK_INTERNAL_ISSUER_URI=http://keycloak:8080/realms/shop-realm

# Service-to-Service OAuth2 Client Credentials
ORDER_SERVICE_CLIENT_ID=order-service-client
ORDER_SERVICE_CLIENT_SECRET=order-client-super-secret

# Redis Rate Limiting Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Ports for Application Services
GATEWAY_PORT=8080
CATALOG_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
FRONTEND_PORT=4200

# Observability Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4317
LOKI_PORT=3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=shop-gateway
