root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 4
max_line_length = 120

[*.xml]
indent_size = 2

[*.{ts,js,html,css,scss,json}]
indent_size = 2
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
